# print-to-bambu configuration — COPY to `bambu.toml` and fill in.
# `bambu.toml` is gitignored: never commit your access code.
# Run: python3 .claude/skills/print-to-bambu/scripts/setup_config.py

[printer]
# From the printer screen: Settings > WLAN (IP) and Settings > Device (serial).
ip          = "192.168.x.x"
serial      = "XXXXXXXXXXXXXXX"
# LAN access code from the printer screen. Prefer the BAMBU_ACCESS_CODE env var;
# if set there, it overrides this field. Leave blank to force using the env var.
access_code = ""

[slicer]
# Leave blank to auto-detect Bambu Studio, then OrcaSlicer. Or set an explicit
# path to the binary (macOS example):
# binary = "/Applications/BambuStudio.app/Contents/MacOS/BambuStudio"
binary = ""

[slice]
# Preset names EXACTLY as they appear in your slicer's dropdowns. preflight.py
# verifies the machine profile exists in the detected slicer before slicing.
# NOTE: the Bambu Lab X2D (April 2026) needs an up-to-date Bambu Studio or
# OrcaSlicer >=2.4-alpha; older builds have no X2D profile.
machine  = "Bambu Lab X2D 0.4 nozzle"
process  = "0.20mm Standard @BBL X2D"
filament = "Bambu PLA Basic @BBL X2D"
plate    = 1
# Build-plate type — sets the bed temperature. One of: "Textured PEI Plate",
# "Smooth PEI Plate", "Cool Plate", "Engineering Plate", "High Temp Plate".
# Leave unset to use the profile default (often "Cool Plate" at a low temp —
# too cold for PLA on a textured PEI plate). Set this to match your real plate.
# bed_type = "Textured PEI Plate"

[print]
# true if filament is fed from an AMS; false for a directly-fed external spool.
# Defaults to true because most Bambu setups have an AMS — if yours is loaded this
# MUST be true, or the printer feeds from the (empty) external path and extrudes
# nothing. Set false only for a directly-fed external spool.
use_ams = true
# Which AMS slot (0-3) to print from when use_ams is true.
ams_tray = 0

[design]
# Used by the design-stl skill. All optional (these are the defaults).
bed            = [256, 256, 260]          # printer bed W, D, H (mm) — X2D
min_wall       = 0.8                       # flag features thinner than this (mm)
overhang_angle = 45                        # deg from horizontal; shallower => supports
views          = ["iso", "front", "top"]  # preview renders to generate
