# Printer credentials / local config — NEVER commit (contains LAN access code)
# Covers per-printer variants (bambu.x2d.toml, bambu.p1s.toml, …) but not
# bambu.toml.example, which is the committed placeholder template.
bambu.toml
bambu.*.toml
!bambu.toml.example

